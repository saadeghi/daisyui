l=\"#00c16a\">\u003C/path>\u003C/svg>\n",{"License":8,"Frameworks":11,"Unique components":15,"Built-in Themes":18,"Supports more than two themes":21,"JavaScript size":24,"Dependencies":27,"Dependency size":30,"GitHub stars":33,"Used by open source projects":35,"NPM downloads":38,"CDN":41,"Semantic class names":43,"Global customizations":45,"works without Node.js":47,"No-build version":49,"P3 colors":51,"RTL support":55,"Runtime CSS customization":57,"Native CSS nesting":59,"Open GitHub issues":61},{"value":9,"desc":10},"MIT","Open source MIT License",{"value":12,"positive":13,"desc":14},"Only Vue",false,"NuxtUI works only with Vue",{"value":16,"desc":17},37,"NuxtUI has 50 Components, 37 of them are unique – for example pagination and button group are considered as same.",{"value":19,"desc":20},2,"NuxtUI has light and dark themes, the primary color is customizable",{"value":22,"positive":13,"desc":23},"No","Does not support more than 2 themes at the same time",{"value":25,"positive":13,"desc":26},"85kB","Imported JavaScript bundle size (minified)",{"value":28,"positive":13,"desc":29},259,"NuxtUI has 259 third-party dependencies. Using more third-party dependencies increases the risk of security vulnerabilities, compatibility problems, and long-term maintenance headaches from deprecated packages.",{"value":31,"positive":13,"desc":32},"151MB",null,{"value":34,"desc":32},6700,{"value":36,"desc":37},"?","No data available",{"value":39,"desc":40},412000,"Weekly downloads from NPM",{"value":22,"positive":13,"desc":42},"NuxtUI CSS file is not available on CDN",{"value":22,"positive":13,"desc":44},"NuxtUI does not use semantic CSS class names. Using semantic and descriptive CSS class names improves readability and maintainability of code independent of the current framework.",{"value":22,"positive":13,"desc":46},"NuxtUI requires changing class names one by one at build time to do customization",{"value":22,"positive":13,"desc":48},"NuxtUI requires a Node.js environment",{"value":22,"positive":13,"desc":50},"NuxtUI does not provide micro CSS files for each component",{"value":52,"positive":53,"desc":54},"Yes",true,"NuxtUI uses wide-gamut P3 colors by default",{"value":52,"positive":53,"desc":56},"NuxtUI supports right-to-left (RTL) layouts",{"value":22,"positive":13,"desc":58},"NuxtUI customizations requires changing JavaScript props at build time",{"value":22,"positive":13,"desc":60},"NuxtUI doesn not use native CSS nesting",{"value":62,"desc":63},188,"As of June 2026","nuxtui",{"name":66,"intro":67,"touse":68,"nottouse":69,"logo":70,"attributes":71,"key":116},"Tailwind Plus","Tailwind Plus is a collection of professionally designed, pre-built UI components built with Tailwind CSS. It's a commercial product, offering a range of application layouts, marketing sections, and component examples. However, some components are only available for React and Vue.","Consider Tailwind Plus when you need high-quality, visually appealing UI components and have a project built with React or Vue (for some components). It's suitable for projects where you want to save time on design and front-end development by using pre-made components.","Avoid Tailwind Plus if you're working on a project with a different framework other than React or Vue, or if you require extensive customization beyond what the components offer. Also, if you prefer open-source solutions or have a limited budget, Tailwind Plus might not be the right choice due to its paid license.","\u003Csvg viewBox=\"0 0 176 21\">\u003Cpath fill=\"oklch(74.6% .16 232.661)\" d=\"M17.183 0C12.6 0 9.737 2.291 8.59 6.873c1.719-2.29 3.723-3.15 6.014-2.577 1.307.326 2.242 1.274 3.275 2.324 1.685 1.71 3.635 3.689 7.894 3.689 4.582 0 7.445-2.291 8.591-6.872-1.718 2.29-3.723 3.15-6.013 2.576-1.308-.326-2.243-1.274-3.276-2.324C23.39 1.98 21.44 0 17.183 0ZM8.59 10.309C4.01 10.309 1.145 12.6 0 17.182c1.718-2.291 3.723-3.15 6.013-2.577 1.308.326 2.243 1.274 3.276 2.324 1.685 1.71 3.635 3.689 7.894 3.689 4.582 0