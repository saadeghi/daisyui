{
  "type": "module",
  "private": true,
  "name": "daisyui-docs",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --open",
    "build": "NODE_ENV=production vite build",
    "build:verify": "bun run --bun build && bun run verify:build",
    "preview": "vite preview --port 3000 --open",
    "build:preview": "bun run --bun build && bun run preview",
    "stats": "open build/stats.html",
    "test": "bun test src",
    "verify": "bun run test && bun run lang:validate",
    "verify:build": "bun src/lib/scripts/verifyBuild.js",
    "lang:add": "bun src/lib/scripts/addTranslations.js --write",
    "lang:prune": "bun src/lib/scripts/pruneTranslations.js",
    "lang:prune:write": "bun src/lib/scripts/pruneTranslations.js --write",
    "lang:report": "bun src/lib/scripts/reportTranslations.js",
    "lang:validate": "bun src/lib/scripts/validateTranslations.js"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.68.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/typography": "0.5.20",
    "daisyui": "workspace:*",
    "json-diff": "1.0.6",
    "mdsvex": "0.12.7",
    "super-sitemap": "1.0.12",
    "svelte": "5.56.4",
    "theme-change": "3.0.4",
    "vite": "8.1.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "dependencies": {
    "@minimal-analytics/ga4": "1.8.7",
    "@neoconfetti/svelte": "2.2.2",
    "culori": "4.0.2",
    "js-yaml": "5.1.0",
    "pako": "2.2.0",
    "svelte-countdown": "1.1.2",
    "svelte-countup": "0.2.8"
  }
}
